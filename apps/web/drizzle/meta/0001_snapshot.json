        "products_sku_canonical_check": {
          "name": "products_sku_canonical_check",
          "value": "octet_length(\"products\".\"sku\") = char_length(\"products\".\"sku\")\n        and \"products\".\"sku\" = upper(\"products\".\"sku\")\n        and \"products\".\"sku\" = btrim(\"products\".\"sku\")\n        and \"products\".\"sku\" !~ '[[:cntrl:]]'\n        and \"products\".\"sku\" !~ '  '"
