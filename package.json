{
  "name": "makhzan",
  "version": "1.0.0",
  "private": true,
  "description": "Makhzan is a bilingual (English and Arabic) multi-tenant inventory management platform for small and medium businesses in the MENA region.",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "test:unit": "npm run test:unit --workspace=apps/web",
    "test:http": "npm run test:http --workspace=apps/web",
    "test:db": "npm run test:db --workspace=apps/web",
    "test:auth": "npm run test:auth --workspace=apps/web",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/web",
    "db:check": "npm run db:check --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "benchmark:products": "npm run benchmark:products --workspace=apps/web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RazanRezq/makhzan.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RazanRezq/makhzan/issues"
  },
  "homepage": "https://github.com/RazanRezq/makhzan#readme"
}
