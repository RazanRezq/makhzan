# Docker web settings.
WEB_PORT=3000
DOCKER_WATCH_POLLING=1
# Compose explicitly sets NODE_ENV=development for the web service.

# Authentication. Generate a unique value of at least 32 characters per
# environment. Never reuse the local value in production.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL is required; Redis is optional/deferred. These local credentials
# match docker-compose.yml.
# If you change a host port, update its connection URL below as well.
POSTGRES_PORT=5432
POSTGRES_DB=makhzan
POSTGRES_USER=makhzan
POSTGRES_PASSWORD=makhzan
REDIS_PORT=6379
DATABASE_URL=postgresql://makhzan:makhzan@127.0.0.1:5432/makhzan
REDIS_URL=redis://127.0.0.1:6379
